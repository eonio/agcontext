{
  "name": "agcontext-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "AGContext (Augmented Context) — a context engineering harness for AI coding agents.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run build --workspace @eonio/agcontext",
    "typecheck": "npm run typecheck --workspace @eonio/agcontext",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace @eonio/agcontext",
    "test:coverage": "npm run test:coverage --workspace @eonio/agcontext",
    "test:e2e": "npm run test:e2e --workspace @eonio/agcontext",
    "bench": "npm run bench --workspace @eonio/agcontext",
    "clean": "npm run clean --workspace @eonio/agcontext"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "semantic-release": "^24.2.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
